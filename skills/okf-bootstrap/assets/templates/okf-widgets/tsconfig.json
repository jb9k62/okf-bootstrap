{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Widgets should run the project's own pure modules, not a copy of them. Point @app at
    // the project's source (vite.config.ts has the matching alias). Unused until a widget
    // imports from it.
    "paths": {
      "@app/*": ["../../src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
